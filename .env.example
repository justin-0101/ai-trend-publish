# ===================================
# 基础服务配置
# ===================================

# LLM 服务配置


# DeepseekAI API配置 https://api-docs.deepseek.com/
DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"
DEEPSEEK_API_KEY="your_api_key"
DEEPSEEK_MODEL="deepseek-chat|deepseek-reasoner"

# 通义千问API配置 https://help.aliyun.com/zh/dashscope/developer-reference/api-details
QWEN_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
QWEN_API_KEY="your_api_key"
QWEN_MODEL="QwQ-Plus"



# 自定义LLM API配置（需要兼容OpenAI API格式）
CUSTOM_LLM_BASE_URL="your_api_base_url"
CUSTOM_LLM_API_KEY="your_api_key"
CUSTOM_LLM_MODEL="your_model_name"

# 默认使用的LLM提供者
# 可选值: OPENAI | DEEPSEEK | QWEN | XUNFEI | CUSTOM
DEFAULT_LLM_PROVIDER="DEEPSEEK"

# 阿里云API配置 https://dashscope.aliyuncs.com/
DASHSCOPE_API_KEY="your_api_key"

# ===================================
# 模块功能配置
# ===================================

# 注意：使用以下配置前，请确保已在上方正确配置了对应的 LLM 服务参数
# 内容排名和摘要模块LLM提供者配置
# 可选值: OPENAI | DEEPSEEK | QWEN | XUNFEI | CUSTOM
AI_CONTENT_RANKER_LLM_PROVIDER="DEEPSEEK:deepseek-reasoner"
AI_SUMMARIZER_LLM_PROVIDER="QWEN:qwen-max"

# 模板配置
# 文章模板类型配置，可选值: default | modern | tech | mianpro | random
ARTICLE_TEMPLATE_TYPE="default"

# HelloGitHub模板类型配置，可选值: weixin | random
HELLOGITHUB_TEMPLATE_TYPE="default"

# AIBench模板类型配置，可选值: default | random
AIBENCH_TEMPLATE_TYPE="default"

# ===================================
# 容错配置（可不填，用默认值）
# ===================================

# 封面图生成失败时的降级策略（第三方图片服务欠费/限额时不再拖垮整条工作流）
#   skip（默认）  : 只告警，继续出稿（无封面）
#   placeholder  : 用本地生成的占位封面（纯渐变 PNG，无文字）；占位也失败则退回 skip
#   fail         : 保持老行为，封面失败就让工作流失败
COVER_FALLBACK_MODE=skip

# 标题生成的 token 预算；推理模型会先花 reasoning token，太小会得到空内容
# （默认 1200；设小了会报“未获取到有效的标题（finish_reason=length...）” ）
AI_SUMMARIZER_TITLE_MAX_TOKENS=1200

# 文章数量配置
ARTICLE_NUM=10

# ===================================
# 深度文工作流（weixin-deep-article）
# ===================================
# 链路：关键词搜索素材 → 主题包聚类 + 爆款评分 → 选 1 个主题
#       → 走写作 skill write-ai-wechat-article 出稿 → 三轮审稿 + 闸门 → 归档
# 默认不自动发布：量表达标只算「机器达标」，skill 规定发布前需作者本人阅读确认。

# 写作 skill 根目录；留空时按内置候选路径探测（F: 优先于 E:）
# DEEP_ARTICLE_SKILL_ROOT="F:/wechat-skills/write-ai-wechat-article"

# 本工作流用的 LLM；不配则回落到 AI_SUMMARIZER_LLM_PROVIDER
# DEEP_ARTICLE_LLM_PROVIDER="DEEPSEEK:deepseek-reasoner"
# 起草与长文润色单独用更强的模型（可选）
# DEEP_ARTICLE_DRAFT_LLM_PROVIDER="DEEPSEEK:deepseek-reasoner"

# 送入主题包的素材上限（条）与单条正文截断长度（字）
DEEP_ARTICLE_MAX_ARTICLES=60
DEEP_ARTICLE_MAX_MATERIALS=60
DEEP_ARTICLE_MATERIAL_CHARS=700

# 素材时效窗口：默认 180 天（约 6 个月）。按 publishDate 统一过滤；
# 无法解析日期的素材不误删，但会在 00-素材清单.md 单独列出。
DEEP_ARTICLE_MAX_AGE_DAYS=180

# X 推文长度门槛：默认 120 字。X 按关键词召回的是整片时间线，里混着大量
# 几十个字的回复/转发/感叹，没有可核验信息，进主题包只会把「素材充分度」抬高。
# 低于门槛的 X 推文不入主题包，但仍会列在 00-素材清单.md 的「因过短被筛掉的 X 推文」里。
# 只卡 X 系来源（x-search / twitter / twitter-cookie / twitter-frontend）；
# firecrawl 抓的文章页不受此限。
DEEP_ARTICLE_MIN_TWEET_CHARS=120

# skill 第 5 步「素材缺口补料」预算：最多抓几个一手链接、每条正文保留多少字。
# 链接只从真实素材 URL/正文提取，不采信模型生成的候选 URL。
DEEP_ARTICLE_GAP_FETCH_LIMIT=3
DEEP_ARTICLE_GAP_FETCH_CHARS=3000

# 作者背景（观察者评论位用）：语料目录、文件数、单文件与总字数上限
# 语料只读，且注入模型前先按敏感名单整行脱敏；实际送入内容会落盘到 output/deep-article-*/02-作者背景.md
DEEP_ARTICLE_AUTHOR_CONTEXT_ROOTS="E:/agent_person_txt,F:/CHC/agent_person/Agent个人档案-2020-2026"
DEEP_ARTICLE_AUTHOR_CONTEXT_MAX_FILES=8
DEEP_ARTICLE_AUTHOR_CONTEXT_PER_FILE_CHARS=1500
DEEP_ARTICLE_AUTHOR_CONTEXT_CHARS=6000

# ---- 记忆包：本地摘要后送 ----
# 只送「认知、观点、价值观、原则、如何看待一件事」类章节。
# 时间线、家庭现状、财务、具体单位与人名等事实性章节一律不进摘要。
# 筛选是确定性的（不做 LLM 摘要），所以送出去了什么可以逐字审计。
# 默认行为：先在 DEEP_ARTICLE_MEMORY_DIR 里找名字含 memory 的最新 .md；
# 关掉就把它（或 DEEP_ARTICLE_MEMORY_PACK 或 DEEP_ARTICLE_MEMORY_DIR）设成空串。
DEEP_ARTICLE_MEMORY_DIR="C:/Users/user/.pi/agent/memory"
# 显式指定记忆包文件；不写则按上面的目录自动发现。留空 = 本次不接记忆包
# DEEP_ARTICLE_MEMORY_PACK=""
DEEP_ARTICLE_MEMORY_CHARS=5000
# 允许清单（覆盖内置默认；留空则用内置）
# DEEP_ARTICLE_MEMORY_SECTIONS="世界观,人生观,稳定优势,阴影面,全链路观,商务判断,职业决策默认原则,决策十问,验证顺序,三种声音,底色,文章骨架,语言偏好,价值冲突时的默认排序,认知风险模式"
# 拒绝清单（优先于允许清单，覆盖内置默认）
# DEEP_ARTICLE_MEMORY_DENY="时间线,家庭与现状,评分表,分场景规则,家书,副业,收入,MBTI,权限边界"

# 隐私闸门名单（逗号分隔）。留空时回落到推送守卫名单里的 block: 条目
# 姓名、单位名都写这里；正文命中即阻断发布
DEEP_ARTICLE_PRIVACY_NAMES=""
# 名单里确实需要放行的词（例如公众号名本身）
DEEP_ARTICLE_PRIVACY_ALLOW=""

# 数据存储配置
ENABLE_DB=true
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=password
DB_DATABASE=trendfinder

# 微信公众号配置
WEIXIN_APP_ID=" "
WEIXIN_APP_SECRET=" "

# 微信文章配置
NEED_OPEN_COMMENT=false
ONLY_FANS_CAN_COMMENT=false
AUTHOR="your_name"

# 数据抓取配置
# FireCrawl配置 https://www.firecrawl.dev/
FIRE_CRAWL_API_KEY="your_api_key"

# Twitter API配置 https://twitterapi.io/
X_API_BEARER_TOKEN="your_api_key"

# ===================================
# Web 控制台配置
# ===================================

# Web 控制台端口，启动后访问 http://localhost:8002
UI_PORT=8002

# 设置为 true 可禁用 Web 控制台，只保留定时任务/脚本能力
DISABLE_UI_SERVER=false

# ===================================
# 其他通用配置
# ===================================

# 通知服务配置
ENABLE_BARK=false
BARK_URL="your_key"

# 钉钉通知配置
ENABLE_DINGDING=false                    # 是否启用钉钉通知
DINGDING_WEBHOOK="your_webhook_url"      # 钉钉机器人的 Webhook URL

# ===================================
# X 关键词搜索采集（skill: x-search-collector）
# ===================================
# 走「已登录 Chrome + huashu-chrome 扩展」的浏览器自动化路线，不需要 X API key。
# 前置条件：Chrome 已登录 X、huashu-chrome 扩展显示「已连接」、本机代理在线（127.0.0.1:7897）。
# 前置条件不满足时服务仍能启动，只在 sourceType=x-search 时以前置条件错误终止。

# skill 目录（默认自动探测 E:/openclaw-skills/x-search-collector）
# X_SEARCH_SKILL_DIR=E:/openclaw-skills/x-search-collector

# node 可执行文件（默认 node）
# X_SEARCH_NODE=node

# 抓哪几个榜单：top,latest / top / latest（latest 才是「最近在聊什么」）
X_SEARCH_PAGES=top,latest

# 每个榜单「滚一屏抓一屏」的轮数；越大条数越多、耗时越长
X_SEARCH_ROUNDS=6

# 单个关键词最多保留多少条。
# 注意：这个截断发生在采集器里，**先于**深度文的 X 短推文过滤（默认 120 字）。
# 设得太小会先砍掉名次靠后的长帖，再把剩下来的短帖筛掉，等于白丢素材。
# 推荐 60：让采集器多拿，把真正的取舍交给 DEEP_ARTICLE_MIN_TWEET_CHARS。
X_SEARCH_MAX_POSTS=60

# 单个关键词采集超时（毫秒）
X_SEARCH_TIMEOUT_MS=600000
