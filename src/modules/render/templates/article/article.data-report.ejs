<!-- Xiaohu 风格：数据简报（data-report） -->
<div style="margin:0 auto;max-width:680px;padding:16px;background:#ffffff;font-family:-apple-system,'PingFang SC','Microsoft YaHei',sans-serif;line-height:1.78;color:#2d3748;">
  <div style="margin:0 0 24px;padding:16px 18px;background:#0f4c81;border-left:6px solid #f59e0b;border-radius:4px;color:#ffffff;line-height:1.3;">
    <div style="font-size:24px;font-weight:800;letter-spacing:1px;"><%= brand || 'AI 周报' %></div>
    <div style="margin-top:8px;font-size:13px;color:#dbeafe;">每日追踪 · 模型、产品与行业动态</div>
  </div>

  <div style="margin:0 0 30px;padding:14px 16px;background:#f8fafc;border:1px solid #e2e8f0;border-radius:6px;">
    <div style="margin:0 0 12px;padding:0 0 8px;border-bottom:3px solid #0f4c81;color:#0f4c81;font-size:18px;font-weight:800;">本期目录</div>
    <% for (var i = 0; i < articles.length; i++) { var tocArticle = articles[i]; %>
      <div style="margin:8px 0;padding:8px 10px;border-left:4px solid #f59e0b;background:#ffffff;color:#334155;font-size:14px;">
        <span style="display:inline-block;min-width:24px;color:#0f4c81;font-weight:800;"><%= (i + 1).toString().padStart(2, '0') %></span>
        <%= tocArticle.title %>
      </div>
    <% } %>
  </div>

  <% for (var j = 0; j < articles.length; j++) { var article = articles[j]; %>
    <div style="margin:0 0 36px;">
      <div style="margin:0 0 16px;padding:0 0 10px;border-bottom:3px solid #0f4c81;line-height:1.3;">
        <div style="font-size:21px;font-weight:800;color:#1f2937;">
          <span style="display:inline-block;margin-right:8px;padding:3px 6px;background:#f59e0b;border-radius:3px;color:#ffffff;font-size:13px;vertical-align:middle;"><%= (j + 1).toString().padStart(2, '0') %></span>
          <%= article.title %>
        </div>
        <div style="margin-top:8px;color:#64748b;font-size:13px;"><%= article.publishDate || '' %></div>
      </div>
      <div style="font-size:16px;color:#2d3748;text-align:justify;">
        <% var content = article.content || ''; var paragraphs = content.split('<next_paragraph />'); for (var k = 0; k < paragraphs.length; k++) { var para = paragraphs[k].trim(); if (para.length > 0) { %>
          <div style="margin:0 0 16px;line-height:1.78;"><%- para %></div>
        <% } } %>
      </div>
    </div>
  <% } %>

  <div style="margin:12px 0 0;padding:14px 16px;background:#f8fafc;border-top:1px solid #e2e8f0;color:#64748b;font-size:13px;text-align:center;">以上为本期 <%= brand || 'AI 周报' %></div>
</div>
